# AI service environment configuration.
# Copy this file to .env and fill in your values.
#
#   MONGODB_URI        — MongoDB connection string
#   OPENAI_API_KEY     — OpenRouter API key
#   AI_MODEL           — OpenRouter model ID (e.g. openai/gpt-4o-mini)
#   AI_HOST            — bind address (default: 127.0.0.1)
#   AI_PORT            — listen port (default: 8001)
#   AI_INTERNAL_TOKEN  — shared secret the backend sends as `x-internal-token`;
#                        required, otherwise the service rejects all requests

MONGODB_URI=mongodb://localhost:27017/SmartStayX
OPENAI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_HOST=127.0.0.1
AI_PORT=8001
AI_INTERNAL_TOKEN=change-me
