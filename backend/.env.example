## Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/SmartStayX?retryWrites=true&w=majority

## Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=redis-16894.c301.ap-south-1-1.ec2.cloud.redislabs.com
REDIS_PORT=16894
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password
REDIS_TLS=true

## Cloudinary
CLOUDINARY_CLOUD_NAME=dxxxxx
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxx

## Stripe
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

## Clerk
# Clerk is the sole auth provider — there is no local password/session auth.
# RBAC source of truth is Clerk `publicMetadata.role` (guest/staff/owner/admin),
# synced into the local User.role via the Clerk webhook and the `protect` middleware.
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx
# Clerk Organizations must be enabled in Clerk Dashboard > Organizations
# Webhook events required: user.created, user.updated, user.deleted,
#   organization.created, organization.updated, organization.deleted,
#   organizationMembership.created, organizationMembership.updated,
#   organizationMembership.deleted

## Admin Access
ADMIN_EMAILS=admin@smartstayx.com,owner@smartstayx.com
ADMIN_DASHBOARD_ACCESS=owner

## AI Microservice (FastAPI concierge chat)
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://127.0.0.1:8001
# Max time (ms) the Express guest-assistant proxy waits for the AI service
AI_SERVICE_TIMEOUT_MS=30000

## ML Microservice (pricing model)
ML_SERVICE_HOST=127.0.0.1
ML_SERVICE_PORT=5000
ML_SERVICE_URL=http://127.0.0.1:5000

## Frontend
FRONTEND_URL=http://localhost:5173

## Booking Configuration
BOOKING_HOLD_MINUTES=15
BOOKING_HOLD_CLEANUP_INTERVAL_MINUTES=1
PLACEHOLDER_EMAIL_DOMAIN=@placeholder.local
DEFAULT_CURRENCY=USD
DEFAULT_COUNTRY=Sri Lanka

## Other
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

## Google
GOOGLE_API_KEY=xxxxx

# Copy to .env and fill values
# - MongoDB: Create Atlas cluster
# - Redis: Install Redis or use Upstash/RedisLabs
# - Stripe: Dashboard -> Developers -> API keys
# - Clerk: Dashboard -> API keys (enable Organizations in Features)
# - Cloudinary: Dashboard
# - OpenAI: Platform -> API keys

