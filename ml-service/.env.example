# ML service environment configuration.
# Copy this file to .env and fill in your values.
#
#   ML_SERVICE_HOST    — bind address (default: 127.0.0.1)
#   ML_SERVICE_PORT    — listen port (default: 5000)
#   DEFAULT_CURRENCY   — currency echoed back when a request omits one (default: USD)
#   ML_INTERNAL_TOKEN  — shared secret the backend sends as `x-internal-token`;
#                        required, otherwise the service rejects all requests
#                        (must match backend/.env ML_INTERNAL_TOKEN)

ML_SERVICE_HOST=127.0.0.1
ML_SERVICE_PORT=5000
DEFAULT_CURRENCY=USD
ML_INTERNAL_TOKEN=change-me
